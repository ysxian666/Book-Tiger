{
  "project_root": "..",
  "seed": 42,
  "run_name": "single_seed_rtx5090_overnight",
  "paths": {
    "review_path": "data/raw/Books.jsonl.gz",
    "meta_path": "data/raw/meta_Books.jsonl.gz",
    "data_dir": "data/overnight",
    "run_dir": "results/overnight",
    "cache_dir": "cache/overnight"
  },
  "source": {
    "dataset": "Amazon Reviews 2023 Books 5-core",
    "review_url": "https://mcauleylab.ucsd.edu/public_datasets/data/amazon_2023/raw/review_categories/Books.jsonl.gz",
    "meta_url": "https://mcauleylab.ucsd.edu/public_datasets/data/amazon_2023/raw/meta_categories/meta_Books.jsonl.gz"
  },
  "data": {
    "source_is_5core": false,
    "min_rating": 1,
    "require_verified_purchase": false,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "min_sequence_length": 5,
    "min_metadata_coverage": 0.9,
    "user_sample_min": 120000,
    "user_sample_max": 240000,
    "user_sample_chunk": 10000,
    "target_interactions": 1000000,
    "top_items": 50000,
    "max_suffix_tokens": 16384,
    "validation_ratio": 0.05,
    "test_user_count": 2500,
    "exhaustive_user_count": 500,
    "duckdb_memory_limit": "16GB",
    "duckdb_threads": 16,
    "parquet_compression": "zstd"
  },
  "features": {
    "text_model": "hyp1231/blair-roberta-base",
    "text_dim": 768,
    "text_batch_size": 64,
    "text_max_length": 256,
    "collaborative_dim": 128,
    "collaborative_svd_components": 128,
    "random_state": 42
  },
  "rqvae": {
    "num_levels": 3,
    "codebook_size": 256,
    "latent_dim": 32,
    "hidden_dim": 512,
    "dropout": 0.1,
    "epochs": 3000,
    "batch_size": 1024,
    "optimizer": "adamw",
    "learning_rate": 0.0005,
    "weight_decay": 0.00001,
    "commitment_weight": 0.25,
    "codebook_weight": 0.25,
    "usage_weight": 0.5,
    "hard_usage_weight": 1,
    "entropy_weight": 0.05,
    "fused_std_floor": 0.02,
    "latent_std_floor": 0.02,
    "diversity_weight": 5,
    "inverse_frequency_power": 0.5,
    "inverse_frequency_clip": 10,
    "temperature": 1,
    "kmeans_init": true,
    "kmeans_max_iter": 100,
    "dead_code_reset": true,
    "dead_code_reset_interval": 10,
    "dead_code_threshold": 0,
    "dead_code_noise": 0.02,
    "dead_code_reset_full_data": true,
    "dead_code_reset_error_aware": true,
    "checkpoint_interval": 100,
    "max_train_minutes": 40
  },
  "sid": {
    "sid_length": 4,
    "length_mode": "fixed",
    "collision_mode": "suffix"
  },
  "sid_allocation": {
    "enabled": true,
    "mode": "behavior_cluster_global",
    "solver": "hierarchical_min_cost_flow",
    "fallback_solver": "greedy_behavior_aware",
    "solver_timeout_seconds": 1800,
    "top_codes_per_level": 8,
    "base_candidates": 16,
    "suffix_candidates_per_original_code": 32,
    "lambda_recon": 1,
    "lambda_semantic": 0.2,
    "lambda_behavior": 0.1,
    "lambda_cluster": 0.1,
    "lambda_usage": 0.02,
    "lambda_pop": 0,
    "num_user_clusters": 32,
    "hard_semantic_budget_ratio": 1.05
  },
  "generator": {
    "architecture": "t5-tiny",
    "d_model": 128,
    "d_ff": 512,
    "num_encoder_layers": 4,
    "num_decoder_layers": 4,
    "num_heads": 6,
    "dropout": 0.1,
    "max_history_items": 20,
    "max_input_tokens": 256,
    "max_target_tokens": 5,
    "use_time_buckets": true,
    "num_time_buckets": 16,
    "use_hashed_user_token": true,
    "num_user_buckets": 2000,
    "train_steps": 50000,
    "batch_size": 256,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "warmup_steps": 1000,
    "gradient_clip": 1,
    "num_workers": 0,
    "bf16": true,
    "eval_every_steps": 1000,
    "checkpoint_interval_steps": 2000,
    "num_beams": 20,
    "length_penalty": 1,
    "max_decode_steps": 4
  },
  "user_context": {
    "enabled": true,
    "fusion": "soft_prefix",
    "num_layers": 2,
    "num_heads": 4,
    "d_model": 128,
    "d_ff": 512,
    "dropout": 0.1,
    "short_window": 5,
    "long_window": 20,
    "num_soft_tokens": 4,
    "use_hashed_user_token": true
  },
  "joint_training": {
    "enabled": true,
    "freeze_codebooks": true,
    "joint_steps": 20000,
    "generator_lr": 0.0001,
    "rqvae_lr": 0.0001,
    "lambda_recon": 1,
    "lambda_next_sid": 1,
    "lambda_ranking": 0.1,
    "lambda_alignment": 0.1,
    "lambda_prefix": 0.05,
    "num_negative_sids": 128
  },
  "runtime": {
    "min_free_disk_gb": 25
  },
  "evaluation": {
    "users": 2500,
    "exhaustive_users": 500,
    "beam": 20,
    "batch_size": 32,
    "metrics": [
      "recall@10",
      "recall@20",
      "ndcg@10",
      "ndcg@20",
      "mrr@20",
      "coverage",
      "invalid_sid_rate"
    ]
  }
}
