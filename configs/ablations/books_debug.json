{
  "seed": 42,
  "paths": {
    "project_root": "../..",
    "review_path": "data/review_Books.jsonl",
    "meta_path": "data/meta_Books.jsonl",
    "output_dir": "tiger_amazon2023/artifacts/books_debug"
  },
  "data": {
    "min_rating": 1.0,
    "require_verified_purchase": false,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "kcore_iterations": 3,
    "min_sequence_length": 7,
    "max_reviews": 200000,
    "max_users": 5000,
    "max_items": 20000,
    "max_meta_records": 1000000,
    "duckdb_memory_limit": "4GB",
    "duckdb_threads": 8,
    "parquet_compression": "zstd"
  },
  "text": {
    "model_name": "hash",
    "device": "auto",
    "batch_size": 256,
    "max_length": 256,
    "output_dim": 384,
    "normalize": true,
    "query_prefix": "",
    "passage_prefix": "",
    "trust_remote_code": false,
    "allow_hash_fallback": true
  },
  "collaborative": {
    "dim": 128,
    "svd_components": 128,
    "min_user_degree": 2,
    "normalize": true,
    "random_state": 42
  },
  "sid": {
    "num_levels": 3,
    "codebook_size": 256,
    "text_dim": 384,
    "collab_dim": 128,
    "hidden_dim": 512,
    "latent_dim": 256,
    "fusion_type": "gate",
    "gate_hidden_dim": 256,
    "dropout": 0.1,
    "epochs": 5,
    "batch_size": 1024,
    "learning_rate": 0.001,
    "weight_decay": 1e-05,
    "commitment_weight": 0.25,
    "codebook_weight": 0.25,
    "usage_weight": 0.01,
    "entropy_weight": 0.001,
    "inverse_frequency_power": 0.5,
    "inverse_frequency_clip": 10.0,
    "temperature": 0.1,
    "kmeans_init": true,
    "kmeans_max_iter": 100,
    "max_conflict_tokens": 16,
    "topk_for_conflict": 8,
    "seed": 42,
    "length_mode": "variable"
  },
  "generator": {
    "architecture": "t5-tiny",
    "d_model": 256,
    "d_ff": 1024,
    "num_layers": 4,
    "num_heads": 8,
    "dropout": 0.1,
    "max_history_items": 20,
    "max_input_tokens": 256,
    "max_target_tokens": 8,
    "use_time_buckets": true,
    "num_time_buckets": 16,
    "use_behavior_tokens": true,
    "epochs": 10,
    "batch_size": 128,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "warmup_steps": 100,
    "gradient_clip": 1.0,
    "num_workers": 0,
    "early_stopping_patience": 4,
    "checkpoint_name": "tiger_generator.pt",
    "decoder": "standard",
    "num_beams": 20,
    "length_penalty": 1.0,
    "max_decode_steps": 8
  },
  "baselines": {
    "models": [
      "popularity",
      "itemcf",
      "twotower",
      "gru4rec",
      "sasrec",
      "bert4rec"
    ],
    "dim": 128,
    "num_layers": 2,
    "num_heads": 4,
    "dropout": 0.2,
    "max_history_items": 50,
    "epochs": 20,
    "batch_size": 256,
    "learning_rate": 0.001,
    "weight_decay": 1e-06,
    "num_negatives": 32,
    "temperature": 0.07,
    "bert_mask_prob": 0.2,
    "early_stopping_patience": 5,
    "checkpoint_name": "baselines.pt"
  },
  "ranker": {
    "type": "logistic",
    "max_candidates": 500,
    "train_negative_ratio": 20,
    "c_value": 1.0,
    "random_state": 42,
    "checkpoint_name": "ranker.joblib"
  },
  "evaluation": {
    "top_k": [
      10,
      20,
      50
    ],
    "primary_k": 20,
    "ranker_k": 10,
    "long_tail_quantile": 0.8,
    "cold_start_max_train_count": 5,
    "batch_size": 64,
    "metrics": [
      "recall",
      "ndcg",
      "mrr",
      "coverage",
      "long_tail_recall",
      "cold_start_recall",
      "invalid_sid_rate",
      "latency"
    ]
  }
}
