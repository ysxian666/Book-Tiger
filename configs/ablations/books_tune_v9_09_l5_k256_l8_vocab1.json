{
  "seed": 42,
  "paths": {
    "project_root": "../..",
    "review_path": "data/review_Books.jsonl",
    "meta_path": "data/meta_Books.jsonl",
    "output_dir": "tiger_amazon2023/artifacts/books_tune_v7_09_l5_k256_l8"
  },
  "data": {
    "min_rating": 1,
    "require_verified_purchase": false,
    "min_user_interactions": 3,
    "min_item_interactions": 2,
    "kcore_iterations": 2,
    "min_sequence_length": 5,
    "max_reviews": 1000000,
    "max_users": 0,
    "max_items": 0,
    "max_meta_records": 1000000,
    "duckdb_memory_limit": "16GB",
    "duckdb_threads": 12,
    "parquet_compression": "zstd"
  },
  "text": {
    "model_name": "hyp1231/blair-roberta-base",
    "device": "cuda",
    "batch_size": 32,
    "max_length": 256,
    "output_dim": 768,
    "normalize": true,
    "query_prefix": "",
    "passage_prefix": "",
    "trust_remote_code": false,
    "allow_hash_fallback": false
  },
  "collaborative": {
    "dim": 128,
    "svd_components": 128,
    "min_user_degree": 2,
    "normalize": true,
    "random_state": 42
  },
  "sid": {
    "num_levels": 5,
    "codebook_size": 256,
    "text_dim": 768,
    "collab_dim": 128,
    "hidden_dim": 256,
    "latent_dim": 8,
    "fusion_type": "gate",
    "gate_hidden_dim": 256,
    "dropout": 0.1,
    "epochs": 100,
    "batch_size": 1024,
    "learning_rate": 0.0005,
    "weight_decay": 0.00001,
    "commitment_weight": 0.25,
    "codebook_weight": 0.25,
    "usage_weight": 0.05,
    "entropy_weight": 0.001,
    "inverse_frequency_power": 0.5,
    "inverse_frequency_clip": 10,
    "temperature": 0.2,
    "kmeans_init": true,
    "kmeans_max_iter": 100,
    "max_conflict_tokens": 1,
    "topk_for_conflict": 64,
    "seed": 42,
    "length_mode": "fixed",
    "hard_usage_weight": 0.1,
    "dead_code_reset": true,
    "dead_code_reset_interval": 10,
    "dead_code_noise": 0.02,
    "joint_collision_weight": 0,
    "dead_code_threshold": 0,
    "dead_code_reset_full_data": true,
    "dead_code_reset_error_aware": true,
    "dead_code_reset_usage": "epoch",
    "usage_ema_decay": 0.9,
    "conflict_reallocation_mode": "all"
  },
  "generator": {
    "architecture": "t5-tiny",
    "d_model": 256,
    "d_ff": 1024,
    "num_layers": 4,
    "num_heads": 8,
    "dropout": 0.1,
    "max_history_items": 20,
    "max_input_tokens": 256,
    "max_target_tokens": 12,
    "use_time_buckets": true,
    "num_time_buckets": 16,
    "use_behavior_tokens": true,
    "epochs": 100,
    "batch_size": 64,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "warmup_steps": 20,
    "gradient_clip": 1,
    "num_workers": 2,
    "early_stopping_patience": 10,
    "checkpoint_name": "tiger_generator.pt",
    "decoder": "constrained",
    "num_beams": 5,
    "length_penalty": 1,
    "max_decode_steps": 12
  },
  "baselines": {
    "models": [
      "popularity",
      "itemcf",
      "twotower",
      "sasrec"
    ],
    "dim": 128,
    "num_layers": 2,
    "num_heads": 4,
    "dropout": 0.2,
    "max_history_items": 50,
    "epochs": 2,
    "batch_size": 64,
    "learning_rate": 0.001,
    "weight_decay": 0.000001,
    "num_negatives": 32,
    "temperature": 0.07,
    "bert_mask_prob": 0.2,
    "early_stopping_patience": 2,
    "checkpoint_name": "baselines.pt"
  },
  "ranker": {
    "type": "logistic",
    "max_candidates": 100,
    "train_negative_ratio": 20,
    "c_value": 1,
    "random_state": 42,
    "checkpoint_name": "ranker.joblib"
  },
  "evaluation": {
    "top_k": [
      10,
      20
    ],
    "primary_k": 20,
    "ranker_k": 10,
    "long_tail_quantile": 0.8,
    "cold_start_max_train_count": 3,
    "batch_size": 32,
    "metrics": [
      "recall",
      "ndcg",
      "mrr",
      "coverage",
      "long_tail_recall",
      "cold_start_recall",
      "invalid_sid_rate",
      "latency"
    ]
  }
}
